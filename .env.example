# ===================================================
# SPLITPAY Configuration Variables
# ===================================================

# Server
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=local

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=splitpay
DB_USER=postgres
DB_PASSWORD=postgres
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/splitpay

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# Security / JWT (Must be at least 256-bit / 32 bytes hex or base64)
JWT_SECRET=9a8b7c6d5e4f3a2b1c0d9e8f7a6b5c4d3e2f1a0b9c8d7e6f5a4b3c2d1e0f9a8b
JWT_EXPIRATION_MS=86400000

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Splitting Engine Defaults
SPLITPAY_SPLITTING_DEFAULT_STRATEGY=MAX_PART_AMOUNT
SPLITPAY_SPLITTING_MAX_PART_AMOUNT=1990.00

# UPI Defaults
SPLITPAY_UPI_DEFAULT_CURRENCY=INR

# Payment Provider Integration
# Set to 'mock' for local/test development; in production provide authorized provider credentials
ACTIVE_PAYMENT_PROVIDER=mock
# AUTHORIZED_PROVIDER_API_KEY=
# AUTHORIZED_PROVIDER_SECRET=
# AUTHORIZED_PROVIDER_WEBHOOK_SECRET=
